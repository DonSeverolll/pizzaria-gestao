# Ambiente de desenvolvimento local (versionado de proposito: sem dados reais).
# Forca o SQLite para que testes locais NAO escrevam no banco de producao.
# Uso: npm run dev   (equivale a node --watch --env-file=.env.development server.js)
NODE_ENV=development
DB_PROVIDER=sqlite
JWT_SECRET=desenvolvimento-local-nao-usar-em-producao
