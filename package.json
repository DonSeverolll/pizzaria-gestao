{
  "name": "pizzaria-gestao",
  "version": "2.0.0",
  "description": "Sistema web para pizzaria com cardápio público e painel administrativo",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --env-file=.env.development server.js",
    "test": "node --test",
    "db:migrate": "node scripts/migrate.js",
    "audit": "npm audit --audit-level=moderate"
  },
  "keywords": [
    "pizzaria",
    "express",
    "sqlite",
    "postgres",
    "jwt",
    "dashboard"
  ],
  "author": "Alejandro",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mercadopago": "^3.6.2",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4"
  }
}
