# Modelo de configuracao. Copie para .env (local) ou cadastre na Vercel em
# Settings > Environment Variables. Nunca versione o .env com valores reais.

# --- Servidor -----------------------------------------------------------------
PORT=3000
# development libera o segredo JWT de reserva; em producao use production.
NODE_ENV=production
# URL publica do site (links do Mercado Pago, webhook e QR code).
PUBLIC_BASE_URL=https://seu-dominio.com.br
# 1 quando estiver atras de proxy fora da Vercel (Render, Nginx...).
TRUST_PROXY=

# --- Seguranca ----------------------------------------------------------------
# Obrigatorio fora do desenvolvimento. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Senha do usuario "admin" criado no primeiro boot de um banco vazio.
ADMIN_INITIAL_PASSWORD=

# --- Banco de dados -----------------------------------------------------------
# sqlite (padrao local) ou postgres.
DB_PROVIDER=postgres
# Conexao do Supabase/Postgres (use uma das duas). Para Postgres local sem
# TLS acrescente ?sslmode=disable.
SUPABASE_DB_URL=
DATABASE_URL=
# Conexoes por instancia (serverless: mantenha baixo, ex. 3).
PG_POOL_MAX=3
# 1 para exigir certificado TLS valido do Postgres.
PGSSL_STRICT=
# Caminho do arquivo SQLite (padrao: data/pizzaria.db).
SQLITE_PATH=

# --- Mercado Pago -------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=
# Chave secreta do webhook (Suas integracoes > Webhooks). Com ela, avisos sem
# assinatura valida sao recusados.
MERCADOPAGO_WEBHOOK_SECRET=

# --- Supabase Storage (upload de imagens) -------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
