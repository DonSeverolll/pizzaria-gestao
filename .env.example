# Modelo de configuracao. Copie para .env (local) ou cadastre na Vercel em
# Settings > Environment Variables. Nunca versione o .env com valores reais.

# --- Servidor -----------------------------------------------------------------
PORT=3000
# development libera o segredo JWT de reserva; em producao use production.
NODE_ENV=production
# URL publica do site (links do Mercado Pago, webhook e QR code).
PUBLIC_BASE_URL=https://seu-dominio.com.br
# 1 quando estiver atras de proxy fora da Vercel (Render, Nginx...).
TRUST_PROXY=

# --- Seguranca ----------------------------------------------------------------
# Obrigatorio fora do desenvolvimento. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Senha do usuario "admin" criado no primeiro boot de um banco vazio.
ADMIN_INITIAL_PASSWORD=

# --- Banco de dados -----------------------------------------------------------
# firestore (Firebase), postgres (Supabase) ou sqlite (padrao local).
DB_PROVIDER=firestore

# --- Firebase (DB_PROVIDER=firestore) -----------------------------------------
# Console do Firebase > Configuracoes do projeto > Contas de servico >
# Gerar nova chave privada. Na Vercel, copie client_email e private_key do
# JSON (a chave pode ir com os "\n" literais).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Bucket do Storage (fotos de produto), ex.: meu-projeto.firebasestorage.app
FIREBASE_STORAGE_BUCKET=
# Alternativa local as duas variaveis acima: caminho do JSON da conta de servico.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Postgres/Supabase (DB_PROVIDER=postgres) ---------------------------------
# Conexao do Supabase/Postgres (use uma das duas). Para Postgres local sem
# TLS acrescente ?sslmode=disable.
SUPABASE_DB_URL=
DATABASE_URL=
# Use a URL do pooler do Supabase (porta 6543, modo transacao) no app; o
# `npm run db:migrate` troca sozinho para a 5432 (modo sessao).
# Conexoes por instancia. Padrao: 3 na Vercel, 10 fora dela.
PG_POOL_MAX=
# 1 para exigir certificado TLS valido do Postgres.
PGSSL_STRICT=
# Caminho do arquivo SQLite (padrao: data/pizzaria.db).
SQLITE_PATH=

# --- Mercado Pago -------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=
# Chave secreta do webhook (Suas integracoes > Webhooks). Com ela, avisos sem
# assinatura valida sao recusados.
MERCADOPAGO_WEBHOOK_SECRET=

# --- Supabase Storage (upload de imagens com DB_PROVIDER=postgres) ------------
# STORAGE_PROVIDER=firebase ou supabase forca um dos dois.
STORAGE_PROVIDER=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
